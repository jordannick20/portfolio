@using Boilerplate.Models
@model ReviewModel

<div>
    <h1 class="text-primary">Potato</h1>
    <img class="border border-primary" src="~/Images/Potato.jpg" alt="Sample Photo" />
    <h6 class="pt-2">a simple potato nothing special.</h6>

    <h3 class="pt-5">Leave a review</h3>
    <form asp-action="AddReview" method="post">

        <div id="star-rating">
            <span class="star" data-value="1">&#9733;</span>
            <span class="star" data-value="2">&#9733;</span>
            <span class="star" data-value="3">&#9733;</span>
            <span class="star" data-value="4">&#9733;</span>
            <span class="star" data-value="5">&#9733;</span>
        </div>

        <input type="hidden" id="Rating" name="Rating" value="0" />

        <label class=" h5 pt-3">First Name:</label>
        <div class="mt-1">
            <input name="First" maxlength="30" class="w-50"></input>
        </div>

        <label class="h5 pt-3">Last Name:</label>
        <div class="mt-1">
            <input name="Last" maxlength="30" class="w-50"></input>
        </div>

        <label class="h5 pt-3">Review : <label class="">(100 char max)</label></label>
        <div class="mt-1">
            <textarea name="Comment" maxlength="100" class="w-50"></textarea>
        </div>

        <button type="submit" class="flex flex-wrap btn btn-primary mt-3 mb-5">
            Submit
        </button>
        
        <br />
        <h3>Comments:</h3>

        @foreach (Review review in Model.Reviews)
        {
            <div id="comcontainer">

                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= review.Rating)
                    {
                        <span id="comstar" style="color:gold;">&#9733;</span>
                    }
                    else
                    {
                        <span id="comstar" style="color:gray">&#9733;</span>
                    }
                }
            
                <h6>@review.Comment</h6>
                <h6 class="lastforreview">
                    @review.First @review.Last
                </h6>
            </div>
                
        }

    </form>

    <script>
            let stars = document.querySelectorAll(".star");
            let ratingInput = document.getElementById("Rating");

            stars.forEach(star => {
                star.addEventListener("click", (e) => {

                    let rating = e.target.dataset.value;

                    ratingInput.value = rating;
 
                    stars.forEach(e => e.classList.remove("selected"));

                    stars.forEach(e => {
                        if (e.dataset.value <= rating) {
                            e.classList.add("selected");
                        }
                    });
                });
            });
            stars.forEach(star => {

                star.addEventListener("mouseover", (e) => {

                    let rating = e.target.dataset.value;

                    stars.forEach(e => {
                        e.style.color = e.dataset.value <= rating ? "gold" : "grey";
                    });
                });

                star.addEventListener("mouseout", (e) => {

                    stars.forEach(e => {

                        if (e.classList.contains("selected")) {
                            e.style.color = "gold";
                        } else {
                            e.style.color = "grey";
                        }

                    });

                });

            });
    </script>

